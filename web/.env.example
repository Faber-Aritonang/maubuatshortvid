# Supabase (opsional) — kosongkan untuk mode lokal tanpa cloud.
# Salin file ini menjadi .env.local lalu isi nilainya, kemudian restart `npm run dev`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Catatan: kunci TTS TIDAK ditaruh di sini (prefix VITE_ berarti ikut ke bundle browser).
# Kunci TTS hanya dibaca server: lihat ../server/.env.example
