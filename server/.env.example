# Salin menjadi server/.env lalu isi salah satu penyedia TTS.
# Server hanya mendengarkan di 127.0.0.1 dan kunci tidak pernah dikirim ke browser.

# --- OpenAI (disarankan) ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Opsional: arahan gaya bicara, mis. "Bicara santai dan bersemangat seperti kreator Indonesia."
OPENAI_TTS_INSTRUCTIONS=

# --- ElevenLabs (alternatif) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Paksa penyedia tertentu: openai | elevenlabs | none
TTS_PROVIDER=

# Port server (Vite mem-proxy /api ke port ini)
PORT=8787
