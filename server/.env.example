# Salin menjadi server/.env lalu isi salah satu penyedia TTS.
# Server hanya mendengarkan di 127.0.0.1 dan kunci tidak pernah dikirim ke browser.

# --- OpenAI (disarankan) ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Opsional: arahan gaya bicara, mis. "Bicara santai dan bersemangat seperti kreator Indonesia."
OPENAI_TTS_INSTRUCTIONS=

# --- ElevenLabs (alternatif) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Paksa penyedia tertentu: openai | elevenlabs | none
TTS_PROVIDER=

# --- LLM untuk membuat ide dari topik ---
# Isi salah satu (atau keduanya). Anthropic diprioritaskan jika LLM_PROVIDER kosong.
# Untuk token DeepSeek dengan format Anthropic: ANTHROPIC_API_KEY=<token DeepSeek>,
# ANTHROPIC_BASE_URL=api.deepseek.com/anthropic, ANTHROPIC_MODEL=deepseek-v4-flash.
# Model Claude hanya bisa dengan kunci Anthropic asli (base URL default).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Paksa penyedia LLM: anthropic | deepseek | none
LLM_PROVIDER=

# Port server (Vite mem-proxy /api ke port ini)
PORT=8787
